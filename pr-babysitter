# Fetch and normalize GitHub check runs to standard format
github_check_runs() {
    local repo="${1}"
    local ref="${2}"

    # Fetch check runs from check-runs API
    local check_runs
    check_runs=$(service_api_get "/repos/${repo}/commits/${ref}/check-runs" | \
    jq '[.check_runs[] | {
        id: .id,
        name: .name,
        state: (
            if .status == "queued" then "QUEUED"
            elif .status == "in_progress" then "IN_PROGRESS"
            elif .status == "completed" and .conclusion == "success" then "SUCCESS"
            elif .status == "completed" and .conclusion == "failure" then "FAILURE"
            elif .status == "completed" and .conclusion == "cancelled" then "CANCELED"
            else "UNKNOWN"
            end
        ),
        link: .html_url,
        completedAt: .completed_at,
        checkSuiteId: .check_suite.id,
        appName: (.app.name // ""),
        isGitHubActions: (.app.slug == "github-actions")
    }]')

    # Fetch commit statuses from statuses API
    local statuses
    statuses=$(service_api_get "/repos/${repo}/statuses/${ref}" | \
    jq '[.[] | {
        id: .id,
        name: .context,
        state: (
            if .state == "pending" then "IN_PROGRESS"
            elif .state == "success" then "SUCCESS"
            elif .state == "failure" or .state == "error" then "FAILURE"
            else "UNKNOWN"
            end
        ),
        link: .target_url,
        completedAt: .updated_at,
        checkSuiteId: .id,
        appName: (.creator.login // "GitHub"),
        isGitHubActions: false
    }]')

    # Combine both check runs and statuses, deduplicate by name
    jq -n --argjson checks "${check_runs}" --argjson statuses "${statuses}" \
        '($checks + $statuses) | unique_by(.name)'
}

# Fetch and normalize GitLab pipeline jobs and commit statuses to standard format
gitlab_check_runs() {
    local repo="${1}"
    local ref="${2}"
    local pr_number="${3}"

    # GitLab: pipeline status from MR data + commit statuses (external jobs)
    local project_id
    project_id=$(get_project_id "${repo}")

    if [ -z "${pr_number:-}" ]; then
        echo "[]"
        return
    fi

    # Get MR data
    local mr_data
    mr_data=$(service_api_get "/projects/${project_id}/merge_requests/${pr_number}")

    # Extract pipeline checks from MR data
    # Prefer head_pipeline if available, otherwise use pipeline
    local pipeline_checks
    pipeline_checks=$(jq '[
        if .head_pipeline != null and .head_pipeline.status != null then
            {
                id: .head_pipeline.id,
                name: "Pipeline",
                state: (
                    if .head_pipeline.status == "created" or .head_pipeline.status == "waiting_for_resource" or .head_pipeline.status == "preparing" or .head_pipeline.status == "pending" or .head_pipeline.status == "scheduled" or .head_pipeline.status == "manual" then "QUEUED"
                    elif .head_pipeline.status == "running" then "IN_PROGRESS"
                    elif .head_pipeline.status == "success" then "SUCCESS"
                    elif .head_pipeline.status == "failed" then "FAILURE"
                    elif .head_pipeline.status == "canceled" or .head_pipeline.status == "skipped" then "CANCELED"
                    else "UNKNOWN"
                    end
                ),
                link: .head_pipeline.web_url,
                completedAt: .head_pipeline.updated_at,
                checkSuiteId: .head_pipeline.id,
                appName: "GitLab CI",
                isGitHubActions: false
            }
        elif .pipeline != null and .pipeline.status != null then
            {
                id: .pipeline.id,
                name: "Pipeline",
                state: (
                    if .pipeline.status == "created" or .pipeline.status == "waiting_for_resource" or .pipeline.status == "preparing" or .pipeline.status == "pending" or .pipeline.status == "scheduled" or .pipeline.status == "manual" then "QUEUED"
                    elif .pipeline.status == "running" then "IN_PROGRESS"
                    elif .pipeline.status == "success" then "SUCCESS"
                    elif .pipeline.status == "failed" then "FAILURE"
                    elif .pipeline.status == "canceled" or .pipeline.status == "skipped" then "CANCELED"
                    else "UNKNOWN"
                    end
                ),
                link: .pipeline.web_url,
                completedAt: .pipeline.updated_at,
                checkSuiteId: .pipeline.id,
                appName: "GitLab CI",
                isGitHubActions: false
            }
        else
            empty
        end
    ]' <<<"${mr_data}")

    # Get commit SHA from MR
    local commit_sha
    commit_sha=$(jq -r '.sha' <<<"${mr_data}")

    # Get commit statuses (external jobs)
    local commit_statuses
    commit_statuses=$(service_api_get "/projects/${project_id}/repository/commits/${commit_sha}/statuses" 2>/dev/null || echo "[]")

    # Transform commit statuses to normalized format
    local external_checks
    external_checks=$(jq '[.[] | {
        id: .id,
        name: .name,
        state: (
            if .status == "pending" then "IN_PROGRESS"
            elif .status == "running" then "IN_PROGRESS"
            elif .status == "success" then "SUCCESS"
            elif .status == "failed" then "FAILURE"
            elif .status == "canceled" then "CANCELED"
            else "UNKNOWN"
            end
        ),
        link: .target_url,
        completedAt: .finished_at,
        checkSuiteId: .id,
        appName: (.author.username // "External"),
        isGitHubActions: false
    }]' <<<"${commit_statuses}")

    # Combine pipeline checks and external checks
    jq -n --argjson pipelines "${pipeline_checks}" --argjson external "${external_checks}" \
        '$pipelines + $external'
}

# Fetch and normalize Gitea/Forgejo commit statuses to standard format
forgejo_check_runs() {
    local repo="${1}"
    local ref="${2}"

    # Gitea/Forgejo commit statuses API
    service_api_get "/repos/${repo}/commits/${ref}/status" | \
    jq '[.statuses[]? | {
        name: .context,
        state: (
            if .status == "pending" then "IN_PROGRESS"
            elif .status == "success" then "SUCCESS"
            elif .status == "failure" or .state == "error" then "FAILURE"
            else "UNKNOWN"
            end
        ),
        link: .target_url,
        completedAt: .updated_at,
        checkSuiteId: .id,
        appName: (.creator.login // "Forgejo"),
        isGitHubActions: false
    }]'
}

# Retrieve check runs for a commit, dispatching to appropriate service
get_check_runs() {
    local repo="${1}"
    local ref="${2}"
    local pr_number="${3:-}"  # Optional third parameter for GitLab
    local service="${SERVICE:-github}"

    case "${service}" in
        github)
            github_check_runs "${repo}" "${ref}"
            ;;
        gitlab|https://*gitlab*)
            gitlab_check_runs "${repo}" "${ref}" "${pr_number}"
            ;;
        *)
            forgejo_check_runs "${repo}" "${ref}"
            ;;
    esac
}

# Execute command silently unless verbose mode is enabled
quiet() {
    local err=0
    if [[ "${VERBOSE:-}" = "YES" ]]; then
        printf "\033[30;1m"
        "$@"
        err=$?
        printf "\033[0m"
    else
        "$@" >/dev/null 2>&1
        err=$?
    fi
    return "${err}"
}

# Request re-run of a specific GitHub check run by ID
rerun_check() {
    local repo="${1}"
    local check_run_id="${2}"

    quiet service_api_post "/repos/${repo}/check-runs/${check_run_id}/rerequest"
}

# Retrieve detailed information about a specific GitHub check run
get_check_run_details() {
    local repo="${1}"
    local check_run_id="${2}"

    service_api_get "/repos/${repo}/check-runs/${check_run_id}" 2>/dev/null || return 1
}

# Extract GitHub Actions workflow run ID from a check run
get_workflow_run_id_from_check() {
    local repo="${1}"
    local check_run_id="${2}"

    # Get check run details and extract workflow run URL
    local details
    details=$(get_check_run_details "${repo}" "${check_run_id}") || return 1

    # Extract run_id from html_url (format: .../actions/runs/{run_id}/...)
    jq -r '.html_url' <<<"${details}" | grep -oP 'runs/\K[0-9]+' | head -1 || return 1
}

# Request re-run of an entire GitHub Actions workflow run
rerun_workflow_run() {
    local repo="${1}"
    local run_id="${2}"

    if ! quiet service_api_post "/repos/${repo}/actions/runs/${run_id}/rerun"; then
        echo "    Warning: Failed to re-run workflow ${run_id}" >&2
        return 1
    fi

    return 0
}

# Request re-run of only failed jobs in a GitHub Actions workflow run
rerun_failed_jobs() {
    local repo="${1}"
    local run_id="${2}"

    if ! quiet service_api_post "/repos/${repo}/actions/runs/${run_id}/rerun-failed-jobs"; then
        echo "    Warning: Failed to re-run failed jobs in workflow ${run_id}" >&2
        return 1
    fi

    return 0
}

# Format and display check runs with emoji indicators and optional links
render_checks() {
    FILTER="${1:-"true"}"
    # Note that the sorting is done so that SUCCESS is the last item.
    cat - | \
    jq -r \
    "[.[] | select(${FILTER})] |
    sort_by(
        if .state == \"FAILURE\" then 1
        elif .state == \"CANCELED\" then 2
        elif .state == \"IN_PROGRESS\" then 3
        elif .state == \"QUEUED\" then 4
        elif .state == \"SUCCESS\" then 6
        else 5 end
    ) | .[] |
        (if .state == \"SUCCESS\" then \"✅\"
         elif .state == \"IN_PROGRESS\" then \"🔵\"
         elif .state == \"QUEUED\" then \"🧵\"
         elif .state == \"FAILURE\" then \"🚨\"
         elif .state == \"CANCELED\" then \"🚫\"
         else \"❓\" end) as \$emoji |
        \"\\(\$emoji) \\(.name)\" +
        (if .state == \"FAILURE\" or .state == \"IN_PROGRESS\" then \"\\n\\(.link)\" else \"\" end)"
}

# Render compact 3-4 line PR/MR summary with emoji-only check status
render_pr_summary() {
    local pr_number="${1}"
    local pr_title="${2}"
    local pr_labels="${3}"
    local pr_url="${4}"
    local checks_json="${5}"
    local eyes_emoji="${6}"
    local push_timestamp="${7}"
    local commit_author="${8}"

    # Determine status glyph based on check states
    local status_glyph=""
    local failed_count
    local active_count
    local success_count
    local total_count

    failed_count=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${checks_json}")
    active_count=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${checks_json}")
    success_count=$(jq "[.[] | select(.state == \"SUCCESS\")] | length" <<<"${checks_json}")
    total_count=$(jq "length" <<<"${checks_json}")

    if [ "${failed_count}" -gt 0 ] && [ "${active_count}" -gt 0 ]; then
        status_glyph="🟡"
    elif [ "${failed_count}" -gt 0 ]; then
        status_glyph="🔴"
    elif [ "${active_count}" -gt 0 ]; then
        status_glyph="⏳"
    elif [ "${total_count}" -gt 0 ] && [ "${success_count}" -eq "${total_count}" ]; then
        status_glyph="✅"
    fi

    # Print PR number, status glyph, eyes emoji, and title (first line)
    # Bold white, folded to 70 characters
    printf "\033[1;37m"
    fold -w 70 -s <<<"#${pr_number} ${status_glyph}${eyes_emoji} ${pr_title}"
    printf "\033[0m"

    # Print PR labels (next line, only if labels exist)
    if [ -n "${pr_labels:-}" ]; then
        printf "Labels: \033[35m%s\033[0m\n" "${pr_labels}"
    fi

    # Print PR URL in cyan (next line)
    printf "\033[36m%s\033[0m\n" "${pr_url}"

    # Print last push timestamp with commit author (after URL, only if available)
    if [ -n "${push_timestamp:-}" ]; then
        if [ -n "${commit_author:-}" ]; then
            printf "Last push: %s by \033[1;33m@%s\033[0m\n" "${push_timestamp}" "${commit_author}"
        else
            echo "Last push: ${push_timestamp}"
        fi
    fi

    # Print "Checks:" on its own line
    echo "Checks:"

    # Get emojis as array (max 50 chars per line)
    local -a emojis
    # shellcheck disable=SC2312
    mapfile -t emojis < <(jq -r \
    "sort_by(
        if .state == \"FAILURE\" then 1
        elif .state == \"CANCELED\" then 2
        elif .state == \"IN_PROGRESS\" then 3
        elif .state == \"QUEUED\" then 4
        elif .state == \"SUCCESS\" then 6
        else 5 end
    ) | .[] |
        (if .state == \"SUCCESS\" then \"✅\"
         elif .state == \"IN_PROGRESS\" then \"🔵\"
         elif .state == \"QUEUED\" then \"🧵\"
         elif .state == \"FAILURE\" then \"🚨\"
         elif .state == \"CANCELED\" then \"🚫\"
         else \"❓\" end)" <<<"${checks_json}")

    # Print emojis with max 50 chars per line
    local current_line=""
    local max_length=50

    for i in "${!emojis[@]}"; do
        local emoji_with_space=" ${emojis[${i}]}"
        local new_length=$((${#current_line} + ${#emoji_with_space}))

        if [ "${new_length}" -gt "${max_length}" ] && [ -n "${current_line}" ]; then
            echo "${current_line}"
            current_line="${emoji_with_space}"
        else
            current_line="${current_line}${emoji_with_space}"
        fi
    done

    # Print final line if not empty
    if [ -n "${current_line}" ]; then
        echo "${current_line}"
    fi
}

# Add a label to a GitHub PR
add_pr_label() {
    local repo="${1}"
    local pr_number="${2}"
    local label="${3}"

    if ! quiet service_api_post "/repos/${repo}/issues/${pr_number}/labels" \
        -H "Content-Type: application/json" \
        -d "{\"labels\":[\"${label}\"]}"
    then
        echo "    Warning: Failed to add label '${label}' to PR #${pr_number}" >&2
        return 1
    fi

    return 0
}

# Send desktop notification when checks fail
send_desktop_notification() {
    local failed_count="${1}"
    local pr_title="${2}"

    # Determine urgency based on failure count
    local urgency="normal"
    if [ "${failed_count}" -gt 5 ]; then
        urgency="critical"
    fi

    # Send notification
    "${NOTIFY}" \
        --urgency="${urgency}" \
        --app-name="pr-babysitter" \
        --icon="dialog-error" \
        "PR Check Failures" \
        "${failed_count} check(s) failed for:\n${pr_title}"
}

# Send desktop notification when all checks pass
send_success_notification() {
    local pr_title="${1}"

    # Send notification
    "${NOTIFY}" \
        --urgency="normal" \
        --app-name="pr-babysitter" \
        --icon="dialog-information" \
        "PR Checks Passed" \
        "All checks passed successfully for:\n${pr_title}"
}

# Re-run individual failed GitHub check runs
github_rerun_check() {
    local repo="${1}"
    local checks_json="${2}"
    local failed_check_filter="${3}"

    echo ""
    echo "Re-running individual check runs..."
    # Get all failed checks with their IDs and names
    jq -r "[.[] | select(${failed_check_filter})] | .[] | \"\(.id)|\(.name)\"" <<<"${checks_json}" | \
    while IFS='|' read -r check_id check_name; do
        echo "  Requesting re-run for: ${check_name}"
        rerun_check "${repo}" "${check_id}" || true
    done
}

# Re-run entire GitHub Actions workflow runs for failed checks
github_rerun_workflow() {
    local repo="${1}"
    local checks_json="${2}"
    local failed_check_filter="${3}"

    echo ""
    echo "Re-running entire workflow runs..."
    # Get unique workflow run IDs from failed GitHub Actions checks
    local failed_ga_checks
    failed_ga_checks=$(jq -r "[.[] | select(${failed_check_filter}) | select(.isGitHubActions == true)] | unique_by(.checkSuiteId)" <<<"${checks_json}")

    # shellcheck disable=SC2312
    if [ "$(jq 'length' <<<"${failed_ga_checks}")" -eq 0 ]; then
        echo "  No GitHub Actions workflows to re-run"
    else
        # shellcheck disable=SC2034
        jq -r '.[] | "\(.id)|\(.name)|\(.appName)"' <<<"${failed_ga_checks}" | \
        while IFS='|' read -r check_id check_name app_name; do
            echo "  Finding workflow run for: ${check_name}"
            run_id=$(get_workflow_run_id_from_check "${repo}" "${check_id}")

            if [ -n "${run_id:-}" ]; then
                echo "    Re-running workflow run ${run_id}..."
                rerun_workflow_run "${repo}" "${run_id}" || true
            else
                echo "    Warning: Could not find workflow run ID"
            fi
        done
    fi
}

# Re-run only failed jobs in GitHub Actions workflow runs
github_rerun_failed_jobs() {
    local repo="${1}"
    local checks_json="${2}"
    local failed_check_filter="${3}"

    echo ""
    echo "Re-running only failed jobs in workflows..."
    # Get unique workflow run IDs from failed GitHub Actions checks
    local failed_ga_checks
    failed_ga_checks=$(jq -r "[.[] | select(${failed_check_filter}) | select(.isGitHubActions == true)] | unique_by(.checkSuiteId)" <<<"${checks_json}")

    # shellcheck disable=SC2312
    if [ "$(jq 'length' <<<"${failed_ga_checks}")" -eq 0 ]; then
        echo "  No GitHub Actions workflows to re-run"
    else
        # shellcheck disable=SC2034
        jq -r '.[] | "\(.id)|\(.name)|\(.appName)"' <<<"${failed_ga_checks}" | \
        while IFS='|' read -r check_id check_name app_name; do
            echo "  Finding workflow run for: ${check_name}"
            run_id=$(get_workflow_run_id_from_check "${repo}" "${check_id}")

            if [ -n "${run_id:-}" ]; then
                echo "    Re-running failed jobs in workflow run ${run_id}..."
                rerun_failed_jobs "${repo}" "${run_id}" || true
            else
                echo "    Warning: Could not find workflow run ID"
            fi
        done
    fi
}

# Prompt for and add a label to a GitHub PR to trigger re-runs
github_rerun_label() {
    local repo="${1}"
    local pr_number="${2}"

    echo ""
    IFS= read -p "Label name: " -r LABEL_NAME
    echo "Adding label '${LABEL_NAME}' to PR #${pr_number}..."
    if add_pr_label "${repo}" "${pr_number}" "${LABEL_NAME}"; then
        echo "  Successfully added label '${LABEL_NAME}'"
    else
        echo "  Failed to add label"
    fi
}

# Prompt user to select a re-run strategy or return preset mode
ask_rerun_option() {
    local rerun_mode="${1}"

    # If mode is already set, return it
    if [ "${rerun_mode}" != "ask" ]; then
        echo "${rerun_mode}"
        return 0
    fi

    # Ask user for re-run option
    echo "" >&2
    echo "Re-run options:" >&2
    echo "  1) Re-run individual check runs (default)" >&2
    echo "  2) Re-run entire workflow runs (all jobs)" >&2
    echo "  3) Re-run only failed jobs in workflows" >&2
    echo "  4) Add a label to re-run checks" >&2
    echo "  n) Skip re-run" >&2
    echo "" >&2
    read -p "Select option (1-3, n): " -n 1 -r
    echo "" >&2

    case ${REPLY} in
        1|"")
            echo "check"
            ;;
        2)
            echo "workflow"
            ;;
        3)
            echo "failed-jobs"
            ;;
        4)
            echo "label"
            ;;
        [Nn])
            echo "skip"
            ;;
        *)
            echo "Invalid option. Skipping re-run." >&2
            echo "skip"
            ;;
    esac
}

# Execute GitHub check re-run action based on user selection or preset mode
github_rerun_action() {
    local service="${SERVICE:-github}"

    # Only allow re-runs for GitHub
    if [ "${service}" != "github" ]; then
        echo ""
        echo "Note: Check re-run functionality is only available for GitHub."
        echo "Gitea/Forgejo services do not support automatic check re-runs via API."
        return 0
    fi

    # Determine re-run mode
    local rerun_action
    rerun_action=$(ask_rerun_option "${RERUN_MODE}")

    # Execute the selected re-run action
    case ${rerun_action} in
        check)
            github_rerun_check "${REPO}" "${CHECKS_JSON}" "${FAILED_CHECK_FILTER}"
            ;;
        workflow)
            github_rerun_workflow "${REPO}" "${CHECKS_JSON}" "${FAILED_CHECK_FILTER}"
            ;;
        failed-jobs)
            github_rerun_failed_jobs "${REPO}" "${CHECKS_JSON}" "${FAILED_CHECK_FILTER}"
            ;;
        label)
            github_rerun_label "${REPO}" "${PR_NUMBER}"
            ;;
        skip)
            echo "Skipping re-run."
            return 0
            ;;
        *)
            echo "Unknown re-run mode: ${rerun_action}. Skipping."
            return 1
            ;;
    esac

    echo "Done."
}

# Monitor multiple PRs/MRs simultaneously with compact status display
monitor_multiple_prs() {
    local repo="${1}"
    shift
    local pr_numbers=("$@")
    local service="${SERVICE:-github}"

    if [ "${service}" = "gitlab" ] || [[ "${service}" =~ gitlab ]]; then
        echo "Retrieving data for ${#pr_numbers[@]} MRs in ${repo}..."
    else
        echo "Retrieving data for ${#pr_numbers[@]} PRs in ${repo}..."
    fi
    echo ""

    # Declare associative arrays to store PR data
    declare -A pr_titles
    declare -A pr_labels
    declare -A pr_head_shas
    declare -A pr_checks
    declare -A pr_authors
    declare -A pr_push_timestamps
    declare -A pr_eyes_emojis
    declare -A pr_commit_authors

    while true; do
        # First loop: Fetch all PR data
        for pr_number in "${pr_numbers[@]}"; do
            # Get PR title
            pr_titles["${pr_number}"]=$(get_pr_title "${pr_number}" "${repo}" 2>/dev/null || echo "")

            if [ -z "${pr_titles[${pr_number}]:-}" ]; then
                pr_labels["${pr_number}"]=""
                pr_head_shas["${pr_number}"]=""
                pr_checks["${pr_number}"]=""
                continue
            fi

            # Get PR labels
            pr_labels["${pr_number}"]=$(get_pr_labels "${pr_number}" "${repo}" 2>/dev/null || echo "")

            # Get latest commit SHA
            pr_head_shas["${pr_number}"]=$(get_pr_head_sha "${pr_number}" "${repo}" 2>/dev/null || echo "")

            if [ -z "${pr_head_shas[${pr_number}]:-}" ]; then
                pr_checks["${pr_number}"]=""
                continue
            fi

            # Get check status
            pr_checks["${pr_number}"]=$(get_check_runs "${repo}" "${pr_head_shas[${pr_number}]}" "${pr_number}" 2>/dev/null || echo "")

            # Get PR author
            pr_authors["${pr_number}"]=$(get_pr_author "${pr_number}" "${repo}" 2>/dev/null || echo "")

            # Get push timestamp
            pr_push_timestamps["${pr_number}"]=$(get_pr_head_commit_timestamp "${pr_number}" "${repo}" "${pr_head_shas[${pr_number}]}" 2>/dev/null || echo "")

            # Get commit author username
            pr_commit_authors["${pr_number}"]=$(get_commit_author_username "${repo}" "${pr_head_shas[${pr_number}]}" 2>/dev/null || echo "")

            # Calculate eyes emoji
            pr_eyes_emojis["${pr_number}"]=""
            if [ -n "${pr_authors[${pr_number}]:-}" ] && [ -n "${pr_push_timestamps[${pr_number}]:-}" ]; then
                local latest_comment_timestamp
                latest_comment_timestamp=$(get_latest_non_author_comment_timestamp "${pr_number}" "${repo}" "${pr_authors[${pr_number}]}" 2>/dev/null || echo "")
                if should_add_eyes_emoji "${pr_push_timestamps[${pr_number}]}" "${latest_comment_timestamp}"; then
                    pr_eyes_emojis["${pr_number}"]=" 👀"
                fi
            fi
        done

        # Clear screen for clean output
        clear

        echo "=================================================="
        if [ "${service}" = "gitlab" ] || [[ "${service}" =~ gitlab ]]; then
            echo "Multi-MR Monitor - ${repo}"
        else
            echo "Multi-PR Monitor - ${repo}"
        fi
        echo "=================================================="
        echo ""

        # Second loop: Display all PR statuses
        for pr_number in "${pr_numbers[@]}"; do
            # Check if we have PR title
            if [ -z "${pr_titles[${pr_number}]:-}" ]; then
                echo "#${pr_number} (Error: Could not retrieve MR/PR)"
                echo ""
                continue
            fi

            # Check if we have HEAD SHA
            if [ -z "${pr_head_shas[${pr_number}]:-}" ]; then
                local pr_url
                pr_url=$(get_pr_url "${repo}" "${pr_number}")
                printf "\033[1;37m"
                fold -w 70 -s <<<"#${pr_number} ${pr_titles[${pr_number}]}"
                printf "\033[0m"
                printf "\033[36m%s\033[0m\n" "${pr_url}"
                if [ "${service}" != "gitlab" ] && [[ ! "${service}" =~ gitlab ]]; then
                    echo "Checks: ❓ (Error: Could not retrieve checks)"
                fi
                echo ""
                continue
            fi

            # Check if we have checks data
            if [ "${pr_checks[${pr_number}]:-null}" = "null" ]; then
                local pr_url
                pr_url=$(get_pr_url "${repo}" "${pr_number}")
                printf "\033[1;37m"
                fold -w 70 -s <<<"#${pr_number} ${pr_titles[${pr_number}]}"
                printf "\033[0m"
                printf "\033[36m%s\033[0m\n" "${pr_url}"
                echo "Checks: ❓ (No checks found)"
                echo ""
                continue
            fi

            # Render PR summary
            local pr_url
            pr_url=$(get_pr_url "${repo}" "${pr_number}")
            render_pr_summary "${pr_number}" "${pr_titles[${pr_number}]}" "${pr_labels[${pr_number}]}" "${pr_url}" "${pr_checks[${pr_number}]}" "${pr_eyes_emojis[${pr_number}]}" "${pr_push_timestamps[${pr_number}]}" "${pr_commit_authors[${pr_number}]}"
            echo ""
        done

        echo "-----------------------------------"
        # shellcheck disable=SC2312
        echo "Last updated: $(date '+%Y-%m-%d %H:%M:%S')"

        # Check overall status across all PRs
        local has_restartable_failures=false
        local all_checks_successful=true

        for pr_number in "${pr_numbers[@]}"; do
            if [ "${pr_checks[${pr_number}]:-null}" != "null" ]; then
                local failed_count
                local active_count
                local success_count
                local total_count
                failed_count=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${pr_checks[${pr_number}]}")
                active_count=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${pr_checks[${pr_number}]}")
                success_count=$(jq "[.[] | select(.state == \"SUCCESS\")] | length" <<<"${pr_checks[${pr_number}]}")
                total_count=$(jq "length" <<<"${pr_checks[${pr_number}]}")

                # Check if this PR has failed checks with no active checks
                if [ "${failed_count}" -gt 0 ] && [ "${active_count}" -eq 0 ]; then
                    has_restartable_failures=true
                fi

                # Check if this PR has all checks successful
                if [ "${total_count}" -eq 0 ] || [ "${success_count}" -ne "${total_count}" ]; then
                    all_checks_successful=false
                fi
            else
                # No checks or error retrieving checks
                all_checks_successful=false
            fi
        done

        # If all checks across all PRs are successful, exit monitoring
        if [ "${all_checks_successful}" = true ]; then
            echo ""
            echo "✅ All checks passed successfully for all monitored PRs!"
            echo "Monitoring stopped."
            echo "-----------------------------------"
            exit 0
        fi

        if [ "${has_restartable_failures}" = true ] && [ "${SERVICE}" = "github" ]; then
            echo "Press 'R' to restart failed checks"
            echo "Press Ctrl+C to stop monitoring"
            echo "-----------------------------------"

            # Wait for input with timeout
            if read -t "${WAIT_TIME}" -n 1 -s -r key; then
                if [[ "${key}" == "R" ]] || [[ "${key}" == "r" ]]; then
                    # Clear screen before showing restart options
                    clear

                    echo "=================================================="
                    echo "Restart Failed Checks"
                    echo "=================================================="

                    # Re-run failed checks for each PR that has failures
                    for pr_number in "${pr_numbers[@]}"; do
                        if [ "${pr_checks[${pr_number}]:-null}" != "null" ]; then
                            local failed_count
                            local active_count
                            failed_count=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${pr_checks[${pr_number}]}")
                            active_count=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${pr_checks[${pr_number}]}")

                            if [ "${failed_count}" -gt 0 ] && [ "${active_count}" -eq 0 ]; then
                                echo ""
                                echo "=================================================="
                                # Display PR title in bold white (folded to 70 characters)
                                printf "\033[1;37m"
                                fold -w 70 -s <<<"PR #${pr_number} - ${pr_titles[${pr_number}]}"
                                printf "\033[0m"
                                # Display labels if any
                                if [ -n "${pr_labels[${pr_number}]:-}" ]; then
                                    printf "Labels: \033[35m%s\033[0m\n" "${pr_labels[${pr_number}]}"
                                fi
                                local pr_url
                                pr_url=$(get_pr_url "${repo}" "${pr_number}")
                                printf "\033[36m%s\033[0m\n" "${pr_url}"
                                echo "=================================================="
                                echo ""

                                # Display detailed check status
                                render_checks <<<"${pr_checks[${pr_number}]}"

                                echo ""
                                echo "-----------------------------------"

                                # Ask user how to restart this PR's checks
                                echo ""
                                echo "Re-run options for PR #${pr_number}:"
                                echo "  1) Re-run individual check runs (default)"
                                echo "  2) Re-run entire workflow runs (all jobs)"
                                echo "  3) Re-run only failed jobs in workflows"
                                echo "  4) Add a label to re-run checks"
                                echo "  s) Skip this PR"
                                echo ""
                                read -p "Select option (1-4, s): " -n 1 -r
                                echo ""

                                case ${REPLY} in
                                    1|"")
                                        echo ""
                                        echo "Re-running individual check runs..."
                                        jq -r '[.[] | select(.state == "FAILURE" or .state == "CANCELED")] | .[] | "\(.id)|\(.name)"' <<<"${pr_checks[${pr_number}]}" | \
                                        while IFS='|' read -r check_id check_name; do
                                            echo "  Requesting re-run for: ${check_name}"
                                            rerun_check "${repo}" "${check_id}" || true
                                        done
                                        echo "Done."
                                        ;;
                                    2)
                                        echo ""
                                        echo "Re-running entire workflow runs..."
                                        FAILED_GA_CHECKS=$(jq -r '[.[] | select(.state == "FAILURE" or .state == "CANCELED") | select(.isGitHubActions == true)] | unique_by(.checkSuiteId)' <<<"${pr_checks[${pr_number}]}")

                                        # shellcheck disable=SC2312
                                        if [ "$(jq 'length' <<<"${FAILED_GA_CHECKS}")" -eq 0 ]; then
                                            echo "  No GitHub Actions workflows to re-run"
                                        else
                                            # shellcheck disable=SC2034
                                            jq -r '.[] | "\(.id)|\(.name)|\(.appName)"' <<<"${FAILED_GA_CHECKS}" | \
                                            while IFS='|' read -r check_id check_name app_name; do
                                                echo "  Finding workflow run for: ${check_name}"
                                                run_id=$(get_workflow_run_id_from_check "${repo}" "${check_id}")

                                                if [ -n "${run_id:-}" ]; then
                                                    echo "    Re-running workflow run ${run_id}..."
                                                    rerun_workflow_run "${repo}" "${run_id}" || true
                                                else
                                                    echo "    Warning: Could not find workflow run ID"
                                                fi
                                            done
                                        fi
                                        echo "Done."
                                        ;;
                                    3)
                                        echo ""
                                        echo "Re-running only failed jobs in workflows..."
                                        FAILED_GA_CHECKS=$(jq -r '[.[] | select(.state == "FAILURE" or .state == "CANCELED") | select(.isGitHubActions == true)] | unique_by(.checkSuiteId)' <<<"${pr_checks[${pr_number}]}")

                                        # shellcheck disable=SC2312
                                        if [ "$(jq 'length' <<<"${FAILED_GA_CHECKS}")" -eq 0 ]; then
                                            echo "  No GitHub Actions workflows to re-run"
                                        else
                                            # shellcheck disable=SC2034
                                            jq -r '.[] | "\(.id)|\(.name)|\(.appName)"' <<<"${FAILED_GA_CHECKS}" | \
                                            while IFS='|' read -r check_id check_name app_name; do
                                                echo "  Finding workflow run for: ${check_name}"
                                                run_id=$(get_workflow_run_id_from_check "${repo}" "${check_id}")

                                                if [ -n "${run_id:-}" ]; then
                                                    echo "    Re-running failed jobs in workflow run ${run_id}..."
                                                    rerun_failed_jobs "${repo}" "${run_id}" || true
                                                else
                                                    echo "    Warning: Could not find workflow run ID"
                                                fi
                                            done
                                        fi
                                        echo "Done."
                                        ;;
                                    4)
                                        echo ""
                                        IFS= read -p "Label name: " -r LABEL_NAME
                                        echo "Adding label '${LABEL_NAME}' to PR #${pr_number}..."
                                        if add_pr_label "${repo}" "${pr_number}" "${LABEL_NAME}"; then
                                            echo "  Successfully added label '${LABEL_NAME}'"
                                        else
                                            echo "  Failed to add label"
                                        fi
                                        ;;
                                    [Ss])
                                        echo "Skipping PR #${pr_number}."
                                        ;;
                                    *)
                                        echo "Invalid option. Skipping PR #${pr_number}."
                                        ;;
                                esac
                            fi
                        fi
                    done

                    echo ""
                    echo "Re-run requests completed."
                    echo ""
                    echo "Retrieving data for ${#pr_numbers[@]} PRs in ${repo}..."
                    echo ""
                fi
            fi
        elif [ "${has_restartable_failures}" = true ]; then
            # Failures exist but service doesn't support re-runs
            echo "Press 'D' to view detailed status"
            echo "Press Ctrl+C to stop monitoring"
            echo "-----------------------------------"

            # Wait for input with timeout
            if read -t "${WAIT_TIME}" -n 1 -s -r key; then
                if [[ "${key}" == "D" ]] || [[ "${key}" == "d" ]]; then
                    # Clear screen before showing detailed status
                    clear

                    echo "=================================================="
                    echo "Detailed Status"
                    echo "=================================================="

                    # Show detailed status for each PR/MR that has failures
                    for pr_number in "${pr_numbers[@]}"; do
                        if [ "${pr_checks[${pr_number}]:-null}" != "null" ]; then
                            local failed_count
                            local active_count
                            failed_count=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${pr_checks[${pr_number}]}")
                            active_count=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${pr_checks[${pr_number}]}")

                            if [ "${failed_count}" -gt 0 ] && [ "${active_count}" -eq 0 ]; then
                                echo ""
                                echo "=================================================="
                                # Display PR/MR title in bold white (folded to 70 characters)
                                printf "\033[1;37m"
                                if [ "${service}" = "gitlab" ] || [[ "${service}" =~ gitlab ]]; then
                                    fold -w 70 -s <<<"MR #${pr_number} - ${pr_titles[${pr_number}]}"
                                else
                                    fold -w 70 -s <<<"PR #${pr_number} - ${pr_titles[${pr_number}]}"
                                fi
                                printf "\033[0m"
                                # Display labels if any
                                if [ -n "${pr_labels[${pr_number}]:-}" ]; then
                                    printf "Labels: \033[35m%s\033[0m\n" "${pr_labels[${pr_number}]}"
                                fi
                                local pr_url
                                pr_url=$(get_pr_url "${repo}" "${pr_number}")
                                printf "\033[36m%s\033[0m\n" "${pr_url}"
                                echo "=================================================="
                                echo ""

                                # Display detailed check status
                                render_checks <<<"${pr_checks[${pr_number}]}"

                                echo ""
                                echo "-----------------------------------"
                            fi
                        fi
                    done

                    echo ""
                    echo "Press ENTER to return to monitoring..."
                    read -r
                    echo ""
                    if [ "${service}" = "gitlab" ] || [[ "${service}" =~ gitlab ]]; then
                        echo "Retrieving data for ${#pr_numbers[@]} MRs in ${repo}..."
                    else
                        echo "Retrieving data for ${#pr_numbers[@]} PRs in ${repo}..."
                    fi
                    echo ""
                fi
            fi
        else
            echo "Press Ctrl+C to stop monitoring"
            echo "-----------------------------------"

            # Wait before next check
            sleep "${WAIT_TIME}"
        fi
    done
}

# Verify required dependencies are installed and available
check_dependencies() {
    MISSING=0

    # Check if curl is installed
    if ! quiet command -v curl; then
        echo "Error: curl is not installed."
        MISSING=1
    fi

    # Check if jq is installed
    if ! quiet command -v jq; then
        echo "Error: jq is not installed."
        MISSING=1
    fi

    # Check if fold is installed
    if ! quiet command -v fold; then
        echo "Error: fold is not installed."
        MISSING=1
    fi

    # Check if git is installed
    if ! quiet command -v git; then
        echo "Error: git is not installed."
        MISSING=1
    fi

    # Check if notify-send is available
    if quiet command -v notify-send; then
        NOTIFY="notify-send"
    fi

    [[ "${MISSING}" -ne 0 ]] && exit 1 || return 0
}

# Check dependencies
check_dependencies

# Default values
WAIT_TIME="${DEFAULT_WAIT_TIME}"
FAILED_ONLY=false
SERVICE="github"  # Default service (github, codeberg, or custom URL)
RERUN_MODE="ask"  # ask, check, workflow, failed-jobs, label
LABEL_NAME=""     # Label name to add to PR when using label mode
CHECK_ID=""       # Direct check run ID to re-run
WORKFLOW_ID=""    # Direct workflow run ID to re-run
MULTI_PR_MODE=false  # Multi-PR monitoring mode
MULTI_PR_REPO=""     # Repository for multi-PR mode

NOTIFY="${NOTIFY:-":"}"

# Parse options
while getopts "fw:s:r:c:W:m:vVh" opt; do
    case ${opt} in
        f)
            FAILED_ONLY=true
            ;;
        w)
            WAIT_TIME="${OPTARG}"
            ;;
        s)
            SERVICE="${OPTARG}"
            ;;
        r)
            # Validate rerun mode
            case "${OPTARG}" in
                check|workflow|failed-jobs|ask)
                    RERUN_MODE="${OPTARG}"
                    ;;
                label:*)
                    RERUN_MODE="label"
                    LABEL_NAME="${OPTARG#label:}"
                    if [[ -z "${LABEL_NAME:-}" ]]
                    then
                        echo "Error: Label name must not be empty."
                        exit 1
                    fi
                    ;;
                *)
                    echo "Error: Invalid rerun mode. Use: check, workflow, failed-jobs, label:NAME, or ask"
                    exit 1
                    ;;
            esac
            ;;
        c)
            # Validate check run ID is numeric
            if ! [[ "${OPTARG}" =~ ^[0-9]+$ ]]; then
                echo "Error: CHECK_ID must be a positive integer"
                exit 1
            fi
            CHECK_ID="${OPTARG}"
            ;;
        W)
            # Validate workflow run ID is numeric
            if ! [[ "${OPTARG}" =~ ^[0-9]+$ ]]; then
                echo "Error: WORKFLOW_ID must be a positive integer"
                exit 1
            fi
            WORKFLOW_ID="${OPTARG}"
            ;;
        m)
            MULTI_PR_MODE=true
            MULTI_PR_REPO="${OPTARG}"
            # Validate REPO format (owner/repo or owner/group/sub/repo for subgroups)
            if ! [[ "${MULTI_PR_REPO}" =~ ^[a-zA-Z0-9_.-]+(/[a-zA-Z0-9_.-]+)+$ ]]; then
                echo "Error: REPO must be in owner/repo format (supports subgroups like owner/group/sub/repo)"
                exit 1
            fi
            ;;
        v)
            VERBOSE="YES"
            ;;
        V)
            echo "pr-babysitter version ${VERSION}"
            exit 0
            ;;
        h)
            usage
            ;;
        *)
            echo "Error: invalid option: ${opt}"
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

# Parse arguments based on mode
if [ "${MULTI_PR_MODE}" = true ]; then
    # Multi-PR monitoring mode: PR numbers are positional arguments
    if [ $# -lt 1 ]; then
        echo "Error: At least one PR_NUMBER required for multi-PR mode"
        usage
    fi

    # Collect all PR numbers from positional arguments
    MULTI_PR_NUMBERS=()
    for arg in "$@"; do
        # Validate each PR_NUMBER is numeric
        if ! [[ "${arg}" =~ ^[0-9]+$ ]]; then
            echo "Error: PR_NUMBER must be a positive integer: ${arg}"
            exit 1
        fi
        MULTI_PR_NUMBERS+=("${arg}")
    done

    # Call multi-PR monitoring function and exit
    monitor_multiple_prs "${MULTI_PR_REPO}" "${MULTI_PR_NUMBERS[@]}"
    exit 0
elif [ -n "${CHECK_ID:-}" ] || [ -n "${WORKFLOW_ID:-}" ]; then
    # Direct re-run mode: only REPO is required
    REPO="${1:-}"
    PR_NUMBER=""

    if [ -z "${REPO:-}" ]; then
        # Try to get repo from git
        REPO=$(get_repo_from_git 2>/dev/null || echo "")
        if [ -z "${REPO:-}" ]; then
            echo "Error: REPO required for direct re-run. Specify as argument or run from git repository."
            exit 1
        fi
    fi
elif [ "${RERUN_MODE}" == "label" ]; then
    PR_NUMBER="${1}"
    REPO="${2:-}"
    if [ -z "${REPO:-}" ]; then
        # Try to get repo from git
        REPO=$(get_repo_from_git 2>/dev/null || echo "")
        if [ -z "${REPO:-}" ]; then
            echo "Error: REPO required for direct re-run. Specify as argument or run from git repository."
            exit 1
        fi
    fi
else
    # Normal PR monitoring mode
    PR_NUMBER="${1}"
    REPO="${2:-}"

    if [ -z "${PR_NUMBER:-}" ]; then
        usage
    fi

    # Validate PR_NUMBER is numeric
    if ! [[ "${PR_NUMBER}" =~ ^[0-9]+$ ]]; then
        echo "Error: PR_NUMBER must be a positive integer"
        exit 1
    fi

    # If REPO is not provided, try to get it from the current git repository
    if [ -z "${REPO:-}" ]; then
        REPO=$(get_repo_from_git 2>/dev/null || echo "")
        if [ -z "${REPO:-}" ]; then
            echo "Error: Could not determine repository. Please specify REPO argument or run from within a git repository."
            exit 1
        fi
    fi
fi

# Validate REPO format (owner/repo or owner/group/sub/repo for subgroups)
if ! [[ "${REPO}" =~ ^[a-zA-Z0-9_.-]+(/[a-zA-Z0-9_.-]+)+$ ]]; then
    echo "Error: REPO must be in owner/repo format (supports subgroups like owner/group/sub/repo)"
    exit 1
fi

# Check if re-run operations are attempted with non-GitHub services
if [ "${SERVICE}" != "github" ]; then
    if [ -n "${CHECK_ID:-}" ] || [ -n "${WORKFLOW_ID:-}" ] || [ "${RERUN_MODE}" == "label" ]; then
        echo "Error: Check re-run operations are only supported for GitHub service." >&2
        echo "Gitea/Forgejo services do not support automatic check re-runs via API." >&2
        exit 1
    fi
    if [ "${RERUN_MODE}" != "ask" ]; then
        echo "Error: Re-run mode '${RERUN_MODE}' is not supported for ${SERVICE}." >&2
        echo "Gitea/Forgejo services do not support automatic check re-runs via API." >&2
        echo "Use '-r ask' or omit the -r option for monitoring mode only." >&2
        exit 1
    fi
fi

# Handle direct re-run mode
if [ -n "${CHECK_ID:-}" ]; then
    echo "Re-running check run ${CHECK_ID} in ${REPO}..."
    if rerun_check "${REPO}" "${CHECK_ID}"; then
        echo "✅ Successfully requested re-run for check ${CHECK_ID}"
    else
        echo "❌ Failed to re-run check ${CHECK_ID}"
        exit 1
    fi
    exit 0
elif [ -n "${WORKFLOW_ID:-}" ]; then
    echo "Re-running workflow run ${WORKFLOW_ID} in ${REPO}..."
    if rerun_workflow_run "${REPO}" "${WORKFLOW_ID}"; then
        echo "✅ Successfully requested re-run for workflow ${WORKFLOW_ID}"
    else
        echo "❌ Failed to re-run workflow ${WORKFLOW_ID}"
        exit 1
    fi
    exit 0
elif [ "${RERUN_MODE}" == "label" ]; then
    echo "Re-runing checks by adding label '${LABEL_NAME}' to '${REPO}'..."
    if add_pr_label "${REPO}" "${PR_NUMBER}" "${LABEL_NAME}"; then
        echo "✅ Successfully add label to ${REPO}"
    else
        echo "❌ Failed to add label to ${REPO}"
        exit 1
    fi
    exit 0
fi

# Get the latest commit SHA for the PR
PR_HEAD_SHA=$(get_pr_head_sha "${PR_NUMBER}" "${REPO}")
if [ -z "${PR_HEAD_SHA:-}" ]; then
    echo "Error: Could not get HEAD SHA for PR #${PR_NUMBER}"
    exit 1
fi

# Get the PR title for notifications
PR_TITLE=$(get_pr_title "${PR_NUMBER}" "${REPO}")
if [ -z "${PR_TITLE:-}" ]; then
    PR_TITLE="PR #${PR_NUMBER}"
fi

# Get the PR labels
PR_LABELS=$(get_pr_labels "${PR_NUMBER}" "${REPO}")

# Get the PR author
PR_AUTHOR=$(get_pr_author "${PR_NUMBER}" "${REPO}")

# Get the PR author display name
PR_AUTHOR_DISPLAY=$(service_get_pr_author_display "${PR_NUMBER}" "${REPO}")

# ANSI color codes
# shellcheck disable=SC2034
WHITE="\033[1;37m"
# shellcheck disable=SC2034
CYAN="\033[36m"
# shellcheck disable=SC2034
RESET="\033[0m"

# If failed-only mode, show failed checks and exit
if [ "${FAILED_ONLY}" = true ]; then
    CHECKS_JSON=$(get_check_runs "${REPO}" "${PR_HEAD_SHA}" "${PR_NUMBER}")
    FAILED_CHECKS=$(jq '[.[] | select(.state != "SUCCESS" and .state != "IN_PROGRESS" and .state != "QUEUED")] | length' <<<"${CHECKS_JSON}")

    if [ "${FAILED_CHECKS}" -eq 0 ]; then
        echo "No failed checks found for PR #${PR_NUMBER}"
        exit 0
    fi

    # Get push timestamp and eyes emoji for failed-only mode
    PR_PUSH_TIMESTAMP=$(get_pr_head_commit_timestamp "${PR_NUMBER}" "${REPO}" "${PR_HEAD_SHA}")
    LATEST_COMMENT_TIMESTAMP=$(get_latest_non_author_comment_timestamp "${PR_NUMBER}" "${REPO}" "${PR_AUTHOR}")
    EYES_EMOJI=""
    if should_add_eyes_emoji "${PR_PUSH_TIMESTAMP}" "${LATEST_COMMENT_TIMESTAMP}"; then
        EYES_EMOJI=" 👀"
    fi

    # Determine status glyph based on check states
    STATUS_GLYPH=""
    FAILED_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${CHECKS_JSON}")
    ACTIVE_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${CHECKS_JSON}")
    SUCCESS_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"SUCCESS\")] | length" <<<"${CHECKS_JSON}")
    TOTAL_COUNT_FOR_GLYPH=$(jq "length" <<<"${CHECKS_JSON}")

    if [ "${FAILED_COUNT_FOR_GLYPH}" -gt 0 ] && [ "${ACTIVE_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="🟡"
    elif [ "${FAILED_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="🔴"
    elif [ "${ACTIVE_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="⏳"
    elif [ "${TOTAL_COUNT_FOR_GLYPH}" -gt 0 ] && [ "${SUCCESS_COUNT_FOR_GLYPH}" -eq "${TOTAL_COUNT_FOR_GLYPH}" ]; then
        STATUS_GLYPH="✅"
    fi

    echo "========================================"
    echo "Failed Checks for PR #${PR_NUMBER}"
    echo "========================================"
    echo ""
    # Display PR title with status glyph and eyes emoji in bold white, folded to 70 characters
    printf "\033[1;37m"
    fold -w 70 -s <<<"PR #${PR_NUMBER} ${STATUS_GLYPH}${EYES_EMOJI} ${PR_TITLE}"
    printf "\033[0m"
    # Display labels if any
    if [ -n "${PR_LABELS:-}" ]; then
        printf "Labels: \033[35m%s\033[0m\n" "${PR_LABELS}"
    fi
    PR_URL=$(get_pr_url "${REPO}" "${PR_NUMBER}")
    printf "\033[36m%s\033[0m\n" "${PR_URL}"
    # Display last push timestamp
    if [ -n "${PR_PUSH_TIMESTAMP:-}" ]; then
        echo "Last push: ${PR_PUSH_TIMESTAMP}"
    fi
    echo ""
    render_checks '.state != "SUCCESS" and .state != "IN_PROGRESS" and .state != "QUEUED"' <<<"${CHECKS_JSON}"
    send_desktop_notification "${FAILED_CHECKS}" "${PR_TITLE}"
    exit 0
fi

# Monitor MR/PR
if [ "${SERVICE}" = "gitlab" ] || [[ "${SERVICE}" =~ gitlab ]]; then
    echo "Monitoring merge request #${PR_NUMBER}..."
else
    echo "Monitoring checks for PR #${PR_NUMBER}..."
fi
echo ""

# Common filters
FAILED_CHECK_FILTER=".state != \"SUCCESS\" and .state != \"IN_PROGRESS\" and .state != \"QUEUED\""
RUNNING_CHECK_FILTER=".state == \"IN_PROGRESS\" or .state == \"QUEUED\""

# Track previous failure count to avoid notification spam
PREV_FAILED_CHECKS=0

while true; do
    # Clear screen for clean output
    clear

    echo "=================================================="

    # Get latest commit SHA (in case there are new commits)
    PR_HEAD_SHA=$(get_pr_head_sha "${PR_NUMBER}" "${REPO}")

    # Get push timestamp
    PR_PUSH_TIMESTAMP=$(get_pr_head_commit_timestamp "${PR_NUMBER}" "${REPO}" "${PR_HEAD_SHA}")

    # Get latest non-author comment timestamp
    LATEST_COMMENT_TIMESTAMP=$(get_latest_non_author_comment_timestamp "${PR_NUMBER}" "${REPO}" "${PR_AUTHOR}")

    # Calculate eyes emoji
    EYES_EMOJI=""
    if should_add_eyes_emoji "${PR_PUSH_TIMESTAMP}" "${LATEST_COMMENT_TIMESTAMP}"; then
        EYES_EMOJI=" 👀"
    fi

    # Get check status first to determine status glyph
    CHECKS_JSON=$(get_check_runs "${REPO}" "${PR_HEAD_SHA}" "${PR_NUMBER}")

    # Determine status glyph based on check states
    STATUS_GLYPH=""
    FAILED_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"FAILURE\" or .state == \"CANCELED\")] | length" <<<"${CHECKS_JSON}")
    ACTIVE_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"IN_PROGRESS\" or .state == \"QUEUED\")] | length" <<<"${CHECKS_JSON}")
    SUCCESS_COUNT_FOR_GLYPH=$(jq "[.[] | select(.state == \"SUCCESS\")] | length" <<<"${CHECKS_JSON}")
    TOTAL_COUNT_FOR_GLYPH=$(jq "length" <<<"${CHECKS_JSON}")

    if [ "${FAILED_COUNT_FOR_GLYPH}" -gt 0 ] && [ "${ACTIVE_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="🟡"
    elif [ "${FAILED_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="🔴"
    elif [ "${ACTIVE_COUNT_FOR_GLYPH}" -gt 0 ]; then
        STATUS_GLYPH="⏳"
    elif [ "${TOTAL_COUNT_FOR_GLYPH}" -gt 0 ] && [ "${SUCCESS_COUNT_FOR_GLYPH}" -eq "${TOTAL_COUNT_FOR_GLYPH}" ]; then
        STATUS_GLYPH="✅"
    fi

    # Display MR/PR title with status glyph and eyes emoji in bold white (folded to 70 characters)
    printf "\033[1;37m"
    if [ "${SERVICE}" = "gitlab" ] || [[ "${SERVICE}" =~ gitlab ]]; then
        fold -w 70 -s <<<"MR #${PR_NUMBER} ${STATUS_GLYPH}${EYES_EMOJI} ${PR_TITLE}"
    else
        fold -w 70 -s <<<"PR #${PR_NUMBER} ${STATUS_GLYPH}${EYES_EMOJI} ${PR_TITLE}"
    fi
    printf "\033[0m"

    # Display labels if any
    if [ -n "${PR_LABELS:-}" ]; then
        printf "Labels: \033[35m%s\033[0m\n" "${PR_LABELS}"
    fi
    PR_URL=$(get_pr_url "${REPO}" "${PR_NUMBER}")
    printf "\033[36m%s\033[0m\n" "${PR_URL}"

    # Display last push timestamp
    if [ -n "${PR_PUSH_TIMESTAMP:-}" ]; then
        echo "Last push: ${PR_PUSH_TIMESTAMP}"
    fi

    # Display author in bright yellow
    if [ -n "${PR_AUTHOR_DISPLAY:-}" ]; then
        printf "Author: \033[1;33m%s\033[0m\n" "${PR_AUTHOR_DISPLAY}"
    fi

    echo "=================================================="
    echo ""

    # Format and display output
    render_checks <<<"${CHECKS_JSON}"

    echo ""
    echo "-----------------------------------"
    # shellcheck disable=SC2312
    echo "Last updated: $(date '+%Y-%m-%d %H:%M:%S')"

    # Check for failed checks and send notification if count changed
    FAILED_CHECKS=$(jq "[.[] | select(${FAILED_CHECK_FILTER})] | length" <<<"${CHECKS_JSON}")
    if [ "${FAILED_CHECKS}" -gt 0 ] && [ "${FAILED_CHECKS}" -ne "${PREV_FAILED_CHECKS}" ]; then
        send_desktop_notification "${FAILED_CHECKS}" "${PR_TITLE}"
        PREV_FAILED_CHECKS="${FAILED_CHECKS}"
    fi

    # Check if there are any IN_PROGRESS or QUEUED checks
    ACTIVE_CHECKS=$(jq "[.[] | select(${RUNNING_CHECK_FILTER})] | length" <<<"${CHECKS_JSON}")

    if [ "${ACTIVE_CHECKS}" -eq 0 ]; then
        echo "All checks completed. Monitoring stopped."
        echo "-----------------------------------"

        if [ "${FAILED_CHECKS}" -gt 0 ]; then
            echo ""
            echo "There are ${FAILED_CHECKS} failed check(s)."
            if [ "${SERVICE}" = "github" ]; then
                github_rerun_action
            else
                echo ""
                echo "Note: Check re-run functionality is only available for GitHub."
                echo "GitLab/Gitea/Forgejo services do not support automatic check re-runs via API."
                break
            fi
        else
            echo ""
            echo "✅ All checks passed successfully!"
            send_success_notification "${PR_TITLE}"
            # Exit monitoring loop
            break
        fi
    fi

    echo "Press Ctrl+C to stop monitoring"
    echo "-----------------------------------"

    # Wait before next check
    sleep "${WAIT_TIME}"
done
