# Retrieve author display name as "Name (@username)" for GitLab MR
gitlab_get_pr_author_display() {
    local pr_number="${1}"
    local repo="${2}"
    local project_id
    project_id=$(get_project_id "${repo}")

    service_api_get "/projects/${project_id}/merge_requests/${pr_number}" | \
        jq -r '(.author.name // .author.username) + " (@" + .author.username + ")"'
}

# Retrieve author display name as "Name (@username)" for GitHub PR
github_get_pr_author_display() {
    local pr_number="${1}"
    local repo="${2}"

    # Get the username from the PR
    local username
    username=$(service_api_get "/repos/${repo}/pulls/${pr_number}" | jq -r '.user.login')

    if [ -z "${username:-}" ] || [ "${username}" = "null" ]; then
        echo ""
        return
    fi

    # Get the full user details from the users endpoint
    local user_data
    user_data=$(service_api_get "/users/${username}")

    # Return formatted name
    echo "${user_data}" | jq -r '(.name // .login) + " (@" + .login + ")"'
}

# Retrieve author display name as "Name (@username)" for Forgejo/Gitea PR
forgejo_get_pr_author_display() {
    local pr_number="${1}"
    local repo="${2}"

    # Get the username from the PR
    local username
    username=$(service_api_get "/repos/${repo}/pulls/${pr_number}" | jq -r '.user.login')

    if [ -z "${username:-}" ] || [ "${username}" = "null" ]; then
        echo ""
        return
    fi

    # Get the full user details from the users endpoint
    local user_data
    user_data=$(service_api_get "/users/${username}")

    # Return formatted name using full_name field
    echo "${user_data}" | jq -r '(.full_name // .login) + " (@" + .login + ")"'
}

# Retrieve author display name as "Name (@username)" for any service
service_get_pr_author_display() {
    local pr_number="${1}"
    local repo="${2}"
    local service="${SERVICE:-github}"

    case "${service}" in
        gitlab|https://*gitlab*)
            gitlab_get_pr_author_display "${pr_number}" "${repo}"
            ;;
        github)
            github_get_pr_author_display "${pr_number}" "${repo}"
            ;;
        *)
            # Forgejo/Gitea or other services
            forgejo_get_pr_author_display "${pr_number}" "${repo}"
            ;;
    esac
}

# Retrieve the username of the author of a specific commit
get_commit_author_username() {
    local repo="${1}"
    local sha="${2}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    case "${service}" in
        gitlab|https://*gitlab*)
            service_api_get "/projects/${project_id}/repository/commits/${sha}" | jq -r '.author_name'
            ;;
        *)
            service_api_get "/repos/${repo}/commits/${sha}" | jq -r '.author.login // .commit.author.name'
            ;;
    esac
}

# Convert ISO 8601 timestamp to YYYY-MM-DD HH:MM:SS format
format_timestamp() {
    local iso8601_timestamp="${1}"

    if [ "${iso8601_timestamp:-null}" = "null" ]; then
        echo ""
        return
    fi

    # Convert ISO 8601 to YYYY-MM-DD HH:MM:SS format
    date -d "${iso8601_timestamp}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo ""
}

# Retrieve and format the commit timestamp for PR/MR head SHA
get_pr_head_commit_timestamp() {
    local pr_number="${1}"
    local repo="${2}"
    local sha="${3}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    local iso_timestamp

    case "${service}" in
        gitlab|https://*gitlab*)
            iso_timestamp=$(service_api_get "/projects/${project_id}/repository/commits/${sha}" | jq -r '.committed_date')
            ;;
        github)
            iso_timestamp=$(service_api_get "/repos/${repo}/commits/${sha}" | jq -r '.commit.committer.date')
            ;;
        *)
            # Gitea/Forgejo uses updated_at field from status endpoint
            iso_timestamp=$(service_api_get "/repos/${repo}/commits?sha=${sha}&limit=1" | jq -r '.[].commit.committer.date')
            ;;
    esac

    format_timestamp "${iso_timestamp}"
}

# Retrieve all comments for a PR/MR
get_pr_comments() {
    local pr_number="${1}"
    local repo="${2}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    case "${service}" in
        gitlab|https://*gitlab*)
            # GitLab merge request notes/comments
            service_api_get "/projects/${project_id}/merge_requests/${pr_number}/notes" 2>/dev/null || echo "[]"
            ;;
        github)
            # GitHub: Fetch both issue comments and review comments
            local issue_comments
            local review_comments

            issue_comments=$(service_api_get "/repos/${repo}/issues/${pr_number}/comments" 2>/dev/null || echo "[]")
            review_comments=$(service_api_get "/repos/${repo}/pulls/${pr_number}/comments" 2>/dev/null || echo "[]")

            # Combine both arrays into a single array
            jq -n --argjson ic "${issue_comments}" --argjson rc "${review_comments}" '$ic + $rc'
            ;;
        *)
            # Gitea/Forgejo: Always return empty array
            echo "[]"
            ;;
    esac
}

# Get timestamp of most recent comment not by the PR/MR author
get_latest_non_author_comment_timestamp() {
    local pr_number="${1}"
    local repo="${2}"
    local pr_author="${3}"
    local service="${SERVICE:-github}"

    if [ -z "${pr_author:-}" ]; then
        echo ""
        return
    fi

    local comments
    comments=$(get_pr_comments "${pr_number}" "${repo}")

    # Filter out author's comments and get the most recent updated_at timestamp
    local latest_timestamp

    case "${service}" in
        gitlab|https://*gitlab*)
            # GitLab uses .author.username instead of .user.login
            latest_timestamp=$(jq -r --arg author "${pr_author}" \
                '[.[] | select(.author.username != $author) | .updated_at] | sort | reverse | .[0] // ""' \
                <<<"${comments}")
            ;;
        *)
            latest_timestamp=$(jq -r --arg author "${pr_author}" \
                '[.[] | select(.user.login != $author) | .updated_at] | sort | reverse | .[0] // ""' \
                <<<"${comments}")
            ;;
    esac

    format_timestamp "${latest_timestamp}"
}

# Determine if eyes emoji should be added (push is newer than last comment)
should_add_eyes_emoji() {
    local push_timestamp="${1}"
    local latest_comment_timestamp="${2}"

    # If no push timestamp, don't add emoji
    if [ -z "${push_timestamp:-}" ]; then
        return 1
    fi

    # If no non-author comments exist, don't add emoji
    if [ -z "${latest_comment_timestamp:-}" ]; then
        return 1
    fi

    # Convert both timestamps to Unix epoch for comparison
    local push_epoch
    local comment_epoch

    push_epoch=$(date -d "${push_timestamp}" '+%s' 2>/dev/null || echo "0")
    comment_epoch=$(date -d "${latest_comment_timestamp}" '+%s' 2>/dev/null || echo "0")

    # Return 0 (true) if push is more recent than latest comment
    [ "${push_epoch}" -gt "${comment_epoch}" ]
}

# Retrieve comma-separated list of labels for a PR/MR
get_pr_labels() {
    local pr_number="${1}"
