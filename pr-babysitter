    local repo="${2}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    case "${service}" in
        gitlab|https://*gitlab*)
            service_api_get "/projects/${project_id}/merge_requests/${pr_number}" | jq -r '.title'
