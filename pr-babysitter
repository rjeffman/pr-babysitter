# Retrieve the author username of a PR/MR
get_pr_author() {
    local pr_number="${1}"
    local repo="${2}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    case "${service}" in
        gitlab|https://*gitlab*)
