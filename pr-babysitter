#!/bin/bash

set -euo pipefail

# Version
readonly VERSION="1.1.0"

# GitHub API constants
readonly GITHUB_API_VERSION="2022-11-28"
readonly GITHUB_ACCEPT_HEADER="application/vnd.github+json"
readonly DEFAULT_WAIT_TIME=300  # 5 minutes

# Source configuration file if it exists
# Configuration file can set GITHUB_TOKEN for authentication
if [ -r "${HOME}/.pr-babysitter" ]; then
    # shellcheck source=/dev/null
    . "${HOME}/.pr-babysitter"
elif [ -r "${HOME}/.config/pr-babysitter" ]; then
    # shellcheck source=/dev/null
    . "${HOME}/.config/pr-babysitter"
fi

# Note: Token warning will be shown later if using GitHub service

# Display usage information and command-line options
usage() {
    echo "Usage: pr-babysitter [OPTIONS] <PR_NUMBER> [REPO]"
    echo "       pr-babysitter [OPTIONS] -c CHECK_ID [REPO]"
    echo "       pr-babysitter [OPTIONS] -W WORKFLOW_ID [REPO]"
    echo "       pr-babysitter [OPTIONS] -m REPO <PR_NUMBER> [PR_NUMBER...]"
    echo ""
    echo "Monitor the status of checks for a GitHub PR, or basic info for GitLab MRs"
    echo ""
    echo "Options:"
    echo "  -f            Only show failed checks, do not monitor (GitHub only)"
    echo "  -w SECONDS    Wait time in seconds between checks (default: 300)"
    echo "  -s SERVICE    Remote service (default: github)"
    echo "                  github              - GitHub (github.com)"
    echo "                  gitlab              - GitLab (gitlab.com)"
    echo "                  codeberg            - Codeberg (codeberg.org)"
    echo "                  https://HOST        - Custom service URL"
    echo "  -r MODE       Re-run mode for failed checks (GitHub only):"
    echo "                  ask         - Prompt for re-run option (default)"
    echo "                  check       - Re-run individual check runs"
    echo "                  workflow    - Re-run entire workflow runs"
    echo "                  failed-jobs - Re-run only failed jobs in workflows"
    echo "                  label:NAME  - Add specified label NAME to the PR"
    echo "  -c CHECK_ID   Directly re-run a specific check run by ID (GitHub only)"
    echo "  -W WORKFLOW_ID Directly re-run a specific workflow run by ID (GitHub only)"
    echo "  -m REPO       Monitor multiple PRs/MRs for the specified repository"
    echo "  -v            Enable verbose mode"
    echo "  -V            Show version and exit"
    echo "  -h            Show this help message"
    echo ""
    echo "Arguments:"
    echo "  PR_NUMBER  The pull/merge request number to monitor"
    echo "  REPO       Optional repository in owner/repo format (defaults to current repo)"
    echo "             Supports subgroups: owner/group/sub/repo (useful for GitLab)"
    echo ""
    echo "Note: Re-run functionality is only available for GitHub"
    exit 0
}

# Extract hostname from service identifier (github, codeberg, gitlab, or custom URL)
get_hostname() {
    local service="${SERVICE:-github}"

    case "${service}" in
        github)
            echo "github.com"
            ;;
        codeberg)
            echo "codeberg.org"
            ;;
        gitlab)
            echo "gitlab.com"
            ;;
        https://*)
            # Extract hostname from URL
            echo "${service#https://}" | cut -d/ -f1
            ;;
        http://*)
            # Extract hostname from URL
            echo "${service#http://}" | cut -d/ -f1
            ;;
        *)
            # Assume it's a hostname
            echo "${service}"
            ;;
    esac
}

# Return the appropriate API base URL for the selected service
get_api_url() {
    local service="${SERVICE:-github}"
    local hostname
    hostname=$(get_hostname)

    case "${service}" in
        github)
            echo "https://api.github.com"
            ;;
        gitlab)
            # GitLab uses /api/v4
            echo "https://${hostname}/api/v4"
            ;;
        codeberg)
            # Codeberg uses Forgejo/Gitea API
            echo "https://${hostname}/api/v1"
            ;;
        https://*|http://*)
            # Check if it's a GitLab instance (look for gitlab in URL)
            if [[ "${service}" =~ gitlab ]]; then
                echo "${service%/}/api/v4"
            else
                # Default to Gitea/Forgejo API
                echo "${service%/}/api/v1"
            fi
            ;;
        *)
            # Default to Gitea/Forgejo API for custom hostnames
            echo "https://${hostname}/api/v1"
            ;;
    esac
}

# Construct the PR/MR web URL based on service type
get_pr_url() {
    local repo="${1}"
    local pr_number="${2}"
    local hostname
    local service="${SERVICE:-github}"
    hostname=$(get_hostname)

    # GitHub uses /pull/ (singular), GitLab uses /-/merge_requests/, Gitea/Forgejo use /pulls/ (plural)
    case "${service}" in
        github)
            echo "https://${hostname}/${repo}/pull/${pr_number}"
            ;;
        gitlab)
            echo "https://${hostname}/${repo}/-/merge_requests/${pr_number}"
            ;;
        https://*|http://*)
            # Check if it's a GitLab instance
            if [[ "${service}" =~ gitlab ]]; then
                echo "https://${hostname}/${repo}/-/merge_requests/${pr_number}"
            else
                echo "https://${hostname}/${repo}/pulls/${pr_number}"
            fi
            ;;
        *)
            echo "https://${hostname}/${repo}/pulls/${pr_number}"
            ;;
    esac
}

# Retrieve GitHub authentication token from environment variables
github_get_token() {
    echo "${GITHUB_TOKEN:-${GH_TOKEN}}"
}

# Retrieve GitLab authentication token from environment variables
gitlab_get_token() {
    echo "${GITLAB_TOKEN:-${GITLAB_ACCESS_TOKEN}}"
}

# Return project identifier (URL-encoded for GitLab, plain for others)
get_project_id() {
    local repo="${1}"
    local service="${SERVICE:-github}"

    case "${service}" in
        gitlab|https://*gitlab*)
            # GitLab requires URL-encoded project path (owner%2Frepo)
            echo "${repo//\//%2F}"
            ;;
        *)
            # Other services use repo directly
            echo "${repo}"
            ;;
    esac
}

# Extract repository owner/name from git remote URL
get_repo_from_git() {
    # Try to extract repository from git remote URL
    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [ -z "${remote_url:-}" ]; then
        return 1
    fi

    # Extract owner/repo (with optional subgroups) from various URL formats:
    # - https://host.com/owner/repo.git
    # - git@host.com:owner/repo.git
    # - https://host.com/owner/repo
    # - https://host.com/owner/group/sub/repo.git (GitLab subgroups)
    if [[ "${remote_url}" =~ (://[^/]+/|:)([^/]+(/[^/]+)+)(\.git)?$ ]]; then
        local repo="${BASH_REMATCH[2]}"
        echo "${repo%.git}"
        return 0
    fi

    return 1
}

# Perform authenticated GET request to GitHub API
github_api_get() {
    local endpoint="${1}"
    shift
    local api_url
    api_url=$(get_api_url)

    local token
    token=$(github_get_token)

    if [ -z "${token:-}" ]; then
        echo "Error: GITHUB_TOKEN or GH_TOKEN environment variable required" >&2
        return 1
    fi

    curl -s -H "Accept: ${GITHUB_ACCEPT_HEADER}" \
        -H "X-GitHub-Api-Version: ${GITHUB_API_VERSION}" \
        -H "Authorization: Bearer ${token}" \
        "${api_url}${endpoint}" \
        "$@"
}

# Perform authenticated POST request to GitHub API
github_api_post() {
    local endpoint="${1}"
    shift
    local api_url
    api_url=$(get_api_url)

    local token
    token=$(github_get_token)

    if [ -z "${token:-}" ]; then
        echo "Error: GITHUB_TOKEN or GH_TOKEN environment variable required" >&2
        return 1
    fi

    curl -s -X POST \
        -H "Accept: ${GITHUB_ACCEPT_HEADER}" \
        -H "X-GitHub-Api-Version: ${GITHUB_API_VERSION}" \
        -H "Authorization: Bearer ${token}" \
        "${api_url}${endpoint}" \
        "$@"
}

# Perform authenticated GET request to GitLab API
gitlab_api_get() {
    local endpoint="${1}"
    shift
    local api_url
    api_url=$(get_api_url)

    local token
    token=$(gitlab_get_token)

    if [ -z "${token:-}" ]; then
        echo "Error: GITLAB_TOKEN or GITLAB_ACCESS_TOKEN environment variable required" >&2
        return 1
    fi

    curl -s -H "PRIVATE-TOKEN: ${token}" \
        "${api_url}${endpoint}" \
        "$@"
}

# Perform authenticated POST request to GitLab API
gitlab_api_post() {
    local endpoint="${1}"
    shift
    local api_url
    api_url=$(get_api_url)

    local token
    token=$(gitlab_get_token)

    if [ -z "${token:-}" ]; then
        echo "Error: GITLAB_TOKEN or GITLAB_ACCESS_TOKEN environment variable required" >&2
        return 1
    fi

    curl -s -X POST \
        -H "PRIVATE-TOKEN: ${token}" \
        "${api_url}${endpoint}" \
        "$@"
}

# Perform GET request to service API with appropriate authentication
service_api_get() {
    local endpoint="${1}"
    shift
    local api_url
    local service="${SERVICE:-github}"
    api_url=$(get_api_url)

    case "${service}" in
        github)
            github_api_get "${endpoint}" "$@"
            ;;
        gitlab|https://*gitlab*)
            gitlab_api_get "${endpoint}" "$@"
            ;;
        *)
            # Gitea/Forgejo - no authentication
            curl -s "${api_url}${endpoint}" "$@"
            ;;
    esac
}

# Perform POST request to service API with appropriate authentication
service_api_post() {
    local endpoint="${1}"
    shift
    local api_url
    local service="${SERVICE:-github}"
    api_url=$(get_api_url)

    case "${service}" in
        github)
            github_api_post "${endpoint}" "$@"
            ;;
        gitlab|https://*gitlab*)
            gitlab_api_post "${endpoint}" "$@"
            ;;
        *)
            # Gitea/Forgejo - no authentication
            curl -s -X POST "${api_url}${endpoint}" "$@"
            ;;
    esac
}

# Retrieve the latest commit SHA for a PR/MR
get_pr_head_sha() {
    local pr_number="${1}"
    local repo="${2}"
    local service="${SERVICE:-github}"
    local project_id
    project_id=$(get_project_id "${repo}")

    case "${service}" in
        gitlab|https://*gitlab*)
            service_api_get "/projects/${project_id}/merge_requests/${pr_number}" | jq -r '.sha'
            ;;
        *)
            service_api_get "/repos/${repo}/pulls/${pr_number}" | jq -r '.head.sha'
            ;;
    esac
}

